# ─── Deployer ────────────────────────────────────────────────────────────────
# Deployer private key. Gas is paid in native USDC on Arc — fund the key via the
# Circle Faucet (testnet) or a USDC withdrawal to Arc (mainnet).
PRIVATE_KEY=0x...

# ─── Protocol wiring ─────────────────────────────────────────────────────────
# Ops multisig controlling pause switches (production: Safe).
GUARDIAN_ADDRESS=0x...
# Protocol fee destination (can be the deployer wallet at launch).
TREASURY_ADDRESS=0x...
# Optional protocol fee in bps (0 = disabled; max 100 = 1%).
PROTOCOL_FEE_BPS=0
# Share of the protocol fee paid to a member's referrer (bps; max 10000).
REFERRAL_SHARE_BPS=0

# ─── Verification (optional) ────────────────────────────────────────────────
BLOCK_EXPLORER_API_KEY=
