# ─── Deployment addresses (after `forge script` — see contracts/) ─────────────
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_REPUTATION_ADDRESS=0x...

# ─── Chain selection: "testnet" (default) or "mainnet" ────────────────────────
NEXT_PUBLIC_DEFAULT_CHAIN=testnet

# ─── RPC overrides (optional — defaults to the public Arc RPCs) ──────────────
NEXT_PUBLIC_RPC_URL_TESTNET=https://rpc.testnet.arc.io
NEXT_PUBLIC_RPC_URL_MAINNET=https://rpc.mainnet.arc.io

# ─── WalletConnect project id for RainbowKit (https://cloud.walletconnect.com) ─
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
